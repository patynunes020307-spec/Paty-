{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$HOME/.claude/youtube\" && cp \"$CLAUDE_PROJECT_DIR/youtube/voice.md\" \"$HOME/.claude/youtube/voice.md\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "humanizer@humanizer": true,
    "diagram-design@diagram-design": true
  },
  "extraKnownMarketplaces": {
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    }
  }
}
